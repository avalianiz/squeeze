{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squeeze",
  "version": "0.2.0",
  "identifier": "com.avalianiz.squeeze",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Squeeze",
        "width": 720,
        "height": 560,
        "minWidth": 400,
        "minHeight": 360,
        "center": true,
        "decorations": false,
        "resizable": true,
        "scrollBarStyle": "fluentOverlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MDFBN0FCQzM0NTQxMkEKUldRcVFVWERxNmNCSmlzaEpIVFdtaFdxMU1RS2llMXdmOVZaNlkyaEFvM3FUTXVyREx2QndsbWgK",
      "endpoints": [
        "https://github.com/avalianiz/squeeze/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "publisher": "avalianiz",
    "copyright": "Copyright © 2026 avalianiz",
    "category": "Video",
    "shortDescription": "Compress videos locally",
    "longDescription": "Squeeze compresses videos on your machine so they fit common upload size limits.",
    "homepage": "https://github.com/avalianiz/squeeze",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4"],
        "name": "Squeeze.mp4",
        "description": "MP4 video",
        "mimeType": "video/mp4",
        "role": "Viewer"
      },
      {
        "ext": ["mkv"],
        "name": "Squeeze.mkv",
        "description": "Matroska video",
        "mimeType": "video/x-matroska",
        "role": "Viewer"
      },
      {
        "ext": ["mov"],
        "name": "Squeeze.mov",
        "description": "QuickTime video",
        "mimeType": "video/quicktime",
        "role": "Viewer"
      },
      {
        "ext": ["avi"],
        "name": "Squeeze.avi",
        "description": "AVI video",
        "mimeType": "video/x-msvideo",
        "role": "Viewer"
      },
      {
        "ext": ["webm"],
        "name": "Squeeze.webm",
        "description": "WebM video",
        "mimeType": "video/webm",
        "role": "Viewer"
      },
      {
        "ext": ["m4v"],
        "name": "Squeeze.m4v",
        "description": "M4V video",
        "mimeType": "video/x-m4v",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Squeeze"
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
